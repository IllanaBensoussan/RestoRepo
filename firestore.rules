rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write only their own fridge and shopping list.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // The shared catalogue: readable by anyone signed in, written only by the
    // seed script (scripts/seed-catalog.mjs, which uses an admin account).
    match /ingredients/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /recipes/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /sources/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /meta/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
