{
  "name": "restofrigo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-restofrigo",
    "dev:emulators": "VITE_FIREBASE_EMULATORS=1 VITE_FIREBASE_API_KEY=demo VITE_FIREBASE_AUTH_DOMAIN=demo-restofrigo.firebaseapp.com VITE_FIREBASE_PROJECT_ID=demo-restofrigo VITE_FIREBASE_APP_ID=demo vite"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.8",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
